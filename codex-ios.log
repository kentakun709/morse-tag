 932:   async function tone(startOffset, duration, epoch = audioEpoch) {
 933:     const ctx = await audio();
 934:     if (!ctx || epoch !== audioEpoch) return;
 935:     const start = ctx.currentTime + startOffset / 1000;
 936:     const end = start + duration / 1000;
 937:     const osc = ctx.createOscillator();
 938:     const gain = ctx.createGain();
 939:     osc.frequency.value = Number(document.querySelector('#frequency').value);
 940:     osc.type = 'sine';
 941:     gain.gain.setValueAtTime(0.0001, start);
 942:     gain.gain.exponentialRampToValueAtTime(0.055, start + Math.min(.012, duration / 5000));
 943:     gain.gain.setValueAtTime(0.055, Math.max(start + .013, end - .018));
 944:     gain.gain.exponentialRampToValueAtTime(0.0001, end);
 945:     osc.connect(gain).connect(ctx.destination);
 946:     const sound = { ctx, osc, gain };
 947:     activeSounds.add(sound);
 948:     osc.onended = () => activeSounds.delete(sound);
 949:     osc.start(start); osc.stop(end + .01);
 950:   }
