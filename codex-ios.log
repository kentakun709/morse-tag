 444:   function buildPlate() {
 445:     const geometry = layoutGeometry();
 446:     for (const [letter, code] of Object.entries(MORSE)) {
 447:       const [x, y] = POS[letter];
 448:       const parentCode = code.slice(0, -1);
 449:       const parentLetter = reverse[parentCode];
 450:       const [px, py] = parentLetter ? POS[parentLetter] : root;
 451:       branchesLayer.append(svg('line', { class: 'branch', x1: px, y1: py, x2: x, y2: y }));
 452: 
 453:       const group = svg('g', {
 454:         class: 'morse-node', id: `node-${letter}`, role: 'button', tabindex: '0',
 455:         'aria-label': `${letter}ã€${spokenCode(code)}`, 'data-letter': letter
 456:       });
 457:       const isDash = code.endsWith('-');
 458:       const vertical = letter === 'J';
 459:       const hit = geometry.hits[letter];
 460:       group.append(svg('rect', { class: 'node-hit', x: hit.left, y: hit.top, width: hit.right-hit.left, height: hit.bottom-hit.top, rx: 10 }));
 461:       if (isDash) {
 462:         group.append(svg('rect', { class: 'lamp', x: x-(vertical?7:15), y: y-(vertical?15:7), width: vertical?14:30, height: vertical?30:14, rx: 7 }));
 463:       } else {
 464:         group.append(svg('circle', { class: 'lamp', cx: x, cy: y, r: 9 }));
 465:       }
 466:       const label = geometry.labels[letter];
 467:       const text = svg('text', { class: 'node-label', x: label.x, y: label.y, 'text-anchor': label.anchor });
 468:       text.textContent = letter;
 469:       group.append(text);
 470:       nodesLayer.append(group);
 471:     }
 472:   }
