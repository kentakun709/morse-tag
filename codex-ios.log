 414:   function direction(from, to) {
 415:     const dx = to[0] - from[0];
 416:     const dy = to[1] - from[1];
 417:     return Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : (dy > 0 ? 'down' : 'up');
 418:   }
