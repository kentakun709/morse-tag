 531:   function spokenCode(code) { return code.replaceAll('.', 'çŸ­ç‚¹ã€').replaceAll('-', 'é•·éŸ³ã€').replace(/ã€$/, ''); }
 532:   function displayCode(code) { return code.replaceAll('.', 'ãƒ»').replaceAll('-', 'ï¼'); }
 533:   function toHiragana(char) {
 534:     const code = char.codePointAt(0);
 535:     return code >= 0x30A1 && code <= 0x30F6 ? String.fromCodePoint(code - 0x60) : char;
 536:   }
 537:   // DOM ã‚„è¨­å®šå€¤ã«ä¾å­˜ã—ãªã„ç´”ç²‹ãªå¤‰æ›é–¢æ•°ã€‚
 538:   function convertText(input) {
 539:     const normalized = input.normalize('NFKC').replace(/[ã€ã€‚]/g, ' ').replace(/ï¼Ÿ/g, '?').replace(/ï¼/g, '!');
 540:     const chars = [...normalized];
 541:     const romanParts = [];
 542:     const errors = [];
 543:     const romanMap = [];
 544:     let pendingSmallTsu = false;
 545:     for (let i = 0; i < chars.length; i++) {
 546:       const original = chars[i];
 547:       const hira = toHiragana(original);
 548:       if (/^[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaffã€…ã€†ã€‡]$/u.test(original)) {
 549:         errors.push({ index: i, char: original, type: 'kanji' });
 550:         continue;
 551:       }
 552:       if (hira === 'ã£') { pendingSmallTsu = true; continue; }
 553:       if (hira === 'ãƒ¼') {
 554:         const soFar = romanParts.join('');
 555:         const vowel = soFar.match(/[aeiou](?=[^aeiou]*$)/i)?.[0];
 556:         if (vowel) { romanParts.push(vowel); romanMap.push(i); }
 557:         else errors.push({ index: i, char: original, type: 'unsupported' });
 558:         continue;
 559:       }
 560:       const pair = i + 1 < chars.length ? hira + toHiragana(chars[i + 1]) : '';
 561:       let syllable = KANA[pair];
 562:       let consumed = 1;
 563:       if (syllable) consumed = 2;
 564:       else syllable = KANA[hira];
 565:       if (syllable) {
 566:         if (pendingSmallTsu) {
 567:           const doubled = syllable.startsWith('ch') ? 't' : (syllable.match(/^[bcdfghjklmnpqrstvwxyz]/)?.[0] || '');
 568:           if (doubled) { romanParts.push(doubled); romanMap.push(i); }
 569:           pendingSmallTsu = false;
 570:         }
 571:         romanParts.push(syllable);
 572:         for (let j = 0; j < syllable.length; j++) romanMap.push(i);
 573:         if (consumed === 2) i++;
 574:         continue;
 575:       }
 576:       if (/^[A-Za-z0-9.,?!/()&:;=+_"'@\-]$/.test(original)) {
 577:         const part = original.toUpperCase(); romanParts.push(part); romanMap.push(i); pendingSmallTsu = false; continue;
 578:       }
 579:       if (/\s/u.test(original)) { romanParts.push(' '); romanMap.push(i); pendingSmallTsu = false; continue; }
 580:       errors.push({ index: i, char: original, type: 'unsupported' });
 581:       pendingSmallTsu = false;
 582:     }
 583:     const rawRoman = romanParts.join('');
 584:     const roman = rawRoman.replace(/\s+/g, ' ').trim();
 585:     const trimmedStart = rawRoman.search(/\S|$/);
 586:     const map = romanMap.slice(Math.max(0, trimmedStart), Math.max(0, trimmedStart) + roman.length);
 587:     const morseTokens = [];
 588:     for (let i = 0; i < roman.length; i++) {
 589:       const char = roman[i];
 590:       if (char === ' ') { if (morseTokens.at(-1)?.char !== ' ') morseTokens.push({ char: ' ', code: '/', sourceIndex: map[i] }); continue; }
 591:       const morseChar = char.toUpperCase();
 592:       const code = ALL_MORSE[morseChar];
 593:       if (code) morseTokens.push({ char: morseChar, code, sourceIndex: map[i] });
 594:       else errors.push({ index: map[i] ?? -1, char, type: 'unsupported' });
 595:     }
 596:     return { normalized, roman, morseTokens, errors };
 597:   }
 598:   // Kuromoji ã®èªžå¢ƒç•Œã¨èª­ã¿ã‚’ã€æ—¢å­˜ã®ã‹ãªâ†’ãƒ˜ãƒœãƒ³å¼å¤‰æ›ã¸æ©‹æ¸¡ã—ã™ã‚‹ç´”ç²‹é–¢æ•°ã€‚
 599:   function convertTokenizedText(input, tokens) {
 600:     const normalized = input.normalize('NFKC').replace(/[ã€ã€‚]/g, ' ').replace(/ï¼Ÿ/g, '?').replace(/ï¼/g, '!');
 601:     const pieces = [];
 602:     const errors = [];
 603:     const sourceIndexes = [];
 604:     for (const token of tokens) {
 605:       const surface = token.surface_form || '';
 606:       const start = Math.max(0, Number(token.word_position || 1) - 1);
 607:       let reading = token.reading;
 608:       if (token.pos === 'åŠ©è©ž' && surface === 'ã¯') reading = 'ãƒ¯';
 609:       else if (token.pos === 'åŠ©è©ž' && surface === 'ã¸') reading = 'ã‚¨';
 610:       else if (token.pos === 'åŠ©è©ž' && surface === 'ã‚’') reading = 'ã‚ª';
 611:       else if (surface === 'è‰¯ã„') reading = 'ã‚¤ã‚¤';
 612: 
 613:       if (KANJI_PATTERN.test(surface) && !reading) {
 614:         [...surface].forEach((char, offset) => errors.push({ index: start + offset, char, type: 'unsupported' }));
 615:         continue;
 616:       }
 617:       const converted = convertText(reading || surface);
 618:       converted.errors.forEach(error => errors.push({
 619:         ...error,
 620:         index: start + Math.min(Math.max(error.index, 0), Math.max(surface.length - 1, 0))
 621:       }));
 622:       if (!converted.roman) continue;
 623:       pieces.push(converted.roman);
 624:       for (let i = 0; i < converted.roman.length; i++) sourceIndexes.push(start);
 625:       sourceIndexes.push(start);
 626:     }
 627:     const roman = pieces.join(' ');
 628:     const morseTokens = [];
 629:     for (let i = 0; i < roman.length; i++) {
 630:       const char = roman[i].toUpperCase();
 631:       if (char === ' ') {
 632:         if (morseTokens.at(-1)?.char !== ' ') morseTokens.push({ char: ' ', code: '/', sourceIndex: sourceIndexes[i] ?? 0 });
 633:         continue;
 634:       }
 635:       const code = ALL_MORSE[char];
 636:       if (code) morseTokens.push({ char, code, sourceIndex: sourceIndexes[i] ?? 0 });
 637:     }
 638:     return { normalized, roman, morseTokens, errors };
 639:   }
 640:   function loadTokenizer() {
 641:     if (tokenizer) return Promise.resolve(tokenizer);
 642:     if (tokenizerPromise) return tokenizerPromise;
 643:     tokenizerPromise = new Promise((resolve, reject) => {
 644:       const build = () => {
 645:         try {
 646:           window.kuromoji.builder({ dicPath: KUROMOJI_DIC }).build((error, builtTokenizer) => {
 647:             if (error || !builtTokenizer) { reject(error || new Error('Kuromoji ã®åˆæœŸåŒ–ã«å¤±æ•—ã—ã¾ã—ãŸ')); return; }
 648:             tokenizer = builtTokenizer;
 649:             resolve(tokenizer);
 650:           });
 651:         } catch (error) { reject(error); }
 652:       };
 653:       if (window.kuromoji) { build(); return; }
 654:       const script = document.createElement('script');
 655:       script.src = KUROMOJI_SCRIPT;
 656:       script.async = true;
 657:       script.addEventListener('load', build, { once: true });
 658:       script.addEventListener('error', () => reject(new Error('Kuromoji ã‚’èª­ã¿è¾¼ã‚ã¾ã›ã‚“ã§ã—ãŸ')), { once: true });
 659:       document.body.append(script);
 660:     }).catch(error => {
 661:       tokenizerFailed = true;
 662:       throw error;
 663:     });
 664:     return tokenizerPromise;
 665:   }
