 703:     const unsupported = conversion.errors.some(error => error.type === 'unsupported');
 704:     const status = document.querySelector('#convert-status');
 705:     status.textContent = statusOverride || (kanji ? 'æ¼¢å­—ã¯ã²ã‚‰ãŒãªã§å…¥åŠ›ã—ã¦ãã ã•ã„' : unsupported ? 'èµ¤ã„æ–‡å­—ã¯æœªå¯¾å¿œã®ãŸã‚ã‚¹ã‚­ãƒƒãƒ—ã—ã¾ã—ãŸ' : '');
 706:     status.className = `status ${statusOverride ? '' : kanji || unsupported ? 'bad' : ''}`;
 707:   }
 708:   async function updateConversion(request) {
 709:     const input = document.querySelector('#convert-input').value;
