  80:   .morse-node.error .lamp { fill: var(--error); stroke: #ffc0c0; filter: url(#redGlow); }
  81:   .morse-node:focus-visible .lamp { stroke: var(--silk); stroke-width: 3; }
  82:   .node-hit { fill: transparent; stroke: none; }
  83:   .tabs {
  84:     display: grid;
  85:     grid-template-columns: repeat(4, 1fr);
  86:     gap: 6px;
  87:     padding: 5px;
  88:     margin-top: 14px;
  89:     border: 1px solid #2a3342;
  90:     border-radius: 14px;
  91:     background: #0d121b;
  92:   }
  93:   .tab {
  94:     min-width: 0;
  95:     min-height: 45px;
  96:     border: 0;
  97:     border-radius: 10px;
  98:     background: transparent;
  99:     color: var(--edge);
 100:     font-weight: 700;
 101:     cursor: pointer;
 102:   }
 103:   .tab[aria-selected="true"] { background: #233027; color: var(--led-on); }
 104:   .panel {
 105:     min-width: 0;
 106:     margin-top: 10px;
 107:     padding: 16px;
 108:     min-height: 178px;
 109:     border: 1px solid #293141;
 110:     border-radius: 16px;
 111:     background: var(--panel);
 112:   }
 113:   .panel[hidden] { display: none; }
 114:   .eyebrow { margin: 0 0 5px; color: var(--edge); font-size: .72rem; letter-spacing: .1em; }
 115:   .instruction { margin: 5px 0 0; color: #aeb6c1; font-size: .78rem; line-height: 1.65; }
 116:   .readout {
 117:     min-height: 52px;
 118:     margin: 0;
 119:     color: var(--led-on);
 120:     font: 600 clamp(2rem, 10vw, 3.1rem)/1.15 "IBM Plex Mono", monospace;
 121:     letter-spacing: .15em;
 122:   }
 123:   .readout .letter { color: var(--silk); font-family: "Saira Semi Condensed", sans-serif; }
 124:   .prompt-row, .quiz-row, .stats { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
 125:   .prompt-letter { color: var(--silk); font: 700 2.5rem/1 "Saira Semi Condensed", sans-serif; }
 126:   .key {
 127:     width: 100%;
 128:     min-height: 78px;
 129:     margin-top: 12px;
 130:     border: 1px solid #647167;
 131:     border-bottom-width: 5px;
 132:     border-radius: 16px;
 133:     background: #1c2820;
 134:     color: var(--led-on);
 135:     font-weight: 700;
 136:     letter-spacing: .08em;
 137:     touch-action: none;
 138:     cursor: pointer;
 139:     user-select: none;
 140:   }
 141:   .key.is-down { transform: translateY(3px); border-bottom-width: 2px; background: #29402f; }
 142:   .action {
 143:     min-height: 42px;
 144:     padding: 0 16px;
 145:     border: 1px solid #596475;
 146:     border-radius: 10px;
 147:     background: #222b39;
 148:     cursor: pointer;
 149:   }
 150:   .status { min-height: 1.5em; margin: 10px 0 0; font-size: .82rem; color: #b9c0ca; }
 151:   .status.good { color: var(--led-on); }
 152:   .status.bad { color: var(--error); }
 153:   .stats { margin-top: 14px; padding-top: 12px; border-top: 1px solid #293141; font-size: .8rem; }
 154:   .stats strong { font-family: "IBM Plex Mono", monospace; color: var(--silk); }
 155:   .convert-input {
 156:     width: 100%; min-height: 86px; resize: vertical; padding: 10px 12px;
 157:     border: 1px solid #596475; border-radius: 10px; background: #0b1018;
 158:     color: var(--silk); line-height: 1.6;
 159:   }
 160:   .convert-preview, .convert-output {
 161:     min-width: 0; overflow-wrap: anywhere; white-space: pre-wrap;
 162:     font-family: "IBM Plex Mono", monospace; line-height: 1.7;
 163:   }
 164:   .convert-preview { min-height: 1.7em; margin: 6px 0 10px; color: #aeb6c1; }
 165:   .convert-output { min-height: 1.7em; margin: 2px 0 10px; color: var(--led-on); }
 166:   .convert-roman { margin: 2px 0 8px; overflow-wrap: anywhere; color: var(--silk); font-family: "IBM Plex Mono", monospace; }
 167:   .convert-error { color: var(--error); text-decoration: underline; text-decoration-thickness: 2px; }
 168:   .convert-active { color: #0A0D13; background: var(--led-on); border-radius: 3px; }
 169:   .convert-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
