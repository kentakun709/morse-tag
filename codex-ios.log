 955:     const osc = ctx.createOscillator();
 956:     const gain = ctx.createGain();
 957:     const now = ctx.currentTime;
 958:     osc.frequency.value = Number(document.querySelector('#frequency').value);
 959:     osc.type = 'sine';
 960:     gain.gain.setValueAtTime(0.0001, now);
 961:     gain.gain.exponentialRampToValueAtTime(0.055, now + .012);
 962:     osc.connect(gain).connect(ctx.destination);
 963:     const sound = { ctx, osc, gain };
 964:     activeSounds.add(sound);
 965:     osc.onended = () => activeSounds.delete(sound);
 966:     osc.start(now);
 967:     heldSound = sound;
 968:   }
