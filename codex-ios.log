 420:   function layoutGeometry() {
 421:     const connected = Object.fromEntries(Object.keys(MORSE).map(letter => [letter, new Set()]));
 422:     for (const [letter, code] of Object.entries(MORSE)) {
 423:       const parent = reverse[code.slice(0, -1)];
 424:       if (!parent) continue;
 425:       connected[letter].add(direction(POS[letter], POS[parent]));
 426:       connected[parent].add(direction(POS[parent], POS[letter]));
 427:     }
 428:     const labels = {};
 429:     const hits = {};
 430:     for (const [letter, [x, y]] of Object.entries(POS)) {
 431:       const side = letter === 'Z' ? 'right' : ['down', 'up', 'right', 'left'].find(candidate => !connected[letter].has(candidate));
 432:       if (!side) throw new Error(`${letter}: ãƒ©ãƒ™ãƒ«ã‚’ç½®ã‘ã‚‹æ–¹å‘ãŒã‚ã‚Šã¾ã›ã‚“ã€‚`);
 433:       const label = side === 'down' ? { x, y: y + 42, anchor: 'middle' } :
 434:         side === 'up' ? { x, y: y - 27, anchor: 'middle' } :
 435:         side === 'right' ? { x: x + 25, y: y + 6, anchor: 'start' } :
 436:         { x: x - 25, y: y + 6, anchor: 'end' };
 437:       const halfWidth = Math.max(10, Math.min(20, x - 15, 505 - x));
 438:       labels[letter] = label;
 439:       hits[letter] = { left: x - halfWidth, right: x + halfWidth, top: y - 22, bottom: y + 22 };
 440:     }
 441:     return { connected, labels, hits };
 442:   }
