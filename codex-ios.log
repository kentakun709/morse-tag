1026:   function chooseWeightedQuestion() {
1027:     const bag = [];
1028:     for (const letter of Object.keys(MORSE)) {
1029:       const score = progress[letter];
1030:       const weight = Math.max(1, 2 + score.wrong * 3 - score.correct);
1031:       for (let i = 0; i < Math.min(weight, 12); i++) bag.push(letter);
1032:     }
1033:     return bag[Math.floor(Math.random() * bag.length)];
