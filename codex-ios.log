 915:   function stopSound(sound) {
 916:     if (!sound || !activeSounds.has(sound)) return;
 917:     const now = sound.ctx.currentTime;
 918:     try {
 919:       sound.gain.gain.cancelScheduledValues(now);
 920:       sound.gain.gain.setValueAtTime(Math.max(sound.gain.gain.value, 0.0001), now);
 921:       sound.gain.gain.exponentialRampToValueAtTime(0.0001, now + .018);
 922:       sound.osc.stop(now + .025);
 923:     } catch (_) {}
 924:     activeSounds.delete(sound);
 925:   }
