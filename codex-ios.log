 711:     if (tokenizerFailed) { renderConversion(convertText(input)); return; }
 712:     renderConversion(convertText(input), 'æ¼¢å­—ã®èª­ã¿ã‚’æº–å‚™ä¸­â€¦ï¼ˆåˆå›žã®ã¿ç´„6MBï¼‰');
 713:     try {
 714:       const activeTokenizer = await loadTokenizer();
 715:       if (request !== conversionRequest || input !== document.querySelector('#convert-input').value) return;
 716:       runKanjiSelfTests(activeTokenizer);
 717:       const normalized = input.normalize('NFKC').replace(/[ã€ã€‚]/g, ' ').replace(/ï¼Ÿ/g, '?').replace(/ï¼/g, '!');
 718:       renderConversion(convertTokenizedText(input, activeTokenizer.tokenize(normalized)));
 719:     } catch (error) {
 720:       console.warn('æ¼¢å­—ã®èª­ã¿è¾¼ã¿:', error.message);
 721:       if (request === conversionRequest) renderConversion(convertText(input));
 722:     }
 723:   }
