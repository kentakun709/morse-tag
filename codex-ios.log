 220: <main class="app">
 221:   <header class="app-header">
 222:     <h1>MORSE TAG</h1>
 223:     <p class="tagline">光でたどる、音で覚える</p>
 224:   </header>
 225: 
 226:   <div class="plate-wrap">
 227:     <svg id="plate" viewBox="0 0 520 760" role="img" aria-labelledby="plate-name plate-desc">
 228:       <title id="plate-name">モールス符号の二分木プレート</title>
 229:       <desc id="plate-desc">左に長音で始まる文字、右に短点で始まる文字を配置した練習用プレート</desc>
 230:       <defs>
 231:         <filter id="greenGlow" x="-200%" y="-200%" width="500%" height="500%">
 232:           <feGaussianBlur stdDeviation="6" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
 233:         </filter>
 234:         <filter id="redGlow" x="-200%" y="-200%" width="500%" height="500%">
 235:           <feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
 236:         </filter>
 237:       </defs>
 238:       <rect class="plate-edge" x="6" y="6" width="508" height="748" rx="34"/>
 239:       <rect class="plate-inner" x="14" y="14" width="492" height="732" rx="27"/>
 240:       <circle class="hanger-rim" cx="469" cy="52" r="23"/><circle class="hanger-hole" cx="469" cy="52" r="11"/>
 241:       <text class="plate-title" x="42" y="58">MORSE</text>
 242:       <text class="plate-subtitle" x="414" y="78" text-anchor="end">CODE</text>
 243:       <g aria-hidden="true">
 244:         <path class="antenna" d="M260 146V111M246 124a20 20 0 0 1 28 0M236 114a34 34 0 0 1 48 0"/>
 245:         <circle cx="260" cy="146" r="4" fill="#D8DDE5"/>
 246:       </g>
 247:       <g id="branches" aria-hidden="true"></g>
 248:       <g id="nodes"></g>
 249:     </svg>
 250:   </div>
 251: 
 252:   <nav class="tabs" role="tablist" aria-label="練習モード">
 253:     <button class="tab" id="tab-explore" role="tab" aria-selected="true" aria-controls="panel-explore" data-mode="explore">さわる</button>
 254:     <button class="tab" id="tab-key" role="tab" aria-selected="false" aria-controls="panel-key" data-mode="key">打つ</button>
 255:     <button class="tab" id="tab-quiz" role="tab" aria-selected="false" aria-controls="panel-quiz" data-mode="quiz">聞く</button>
 256:     <button class="tab" id="tab-convert" role="tab" aria-selected="false" aria-controls="panel-convert" data-mode="convert">変換</button>
 257:   </nav>
 258: 
 259:   <section class="panel" id="panel-explore" role="tabpanel" aria-labelledby="tab-explore">
 260:     <p class="eyebrow">選んだ文字</p>
 261:     <p class="readout"><span class="letter" id="explore-letter">E</span>&nbsp; <span id="explore-code">・</span></p>
 262:     <p class="instruction">プレートの文字を押すと、根から光と音が順番にたどります。</p>
 263:   </section>
 264: 
 265:   <section class="panel" id="panel-key" role="tabpanel" aria-labelledby="tab-key" hidden>
 266:     <div class="prompt-row">
 267:       <div><p class="eyebrow">お題</p><div class="prompt-letter" id="key-prompt">A</div></div>
 268:       <div><p class="eyebrow">入力</p><p class="readout" id="key-code">—</p></div>
 269:     </div>
 270:     <button class="key" id="telegraph-key" type="button">長さを変えて押す</button>
 271:     <p class="instruction">短く押すと「・」、長く押すと「－」。スペースキーでも打てます。</p>
 272:     <p class="status" id="key-status" aria-live="polite"></p>
 273:   </section>
 274: 
 275:   <section class="panel" id="panel-quiz" role="tabpanel" aria-labelledby="tab-quiz" hidden>
 276:     <div class="quiz-row">
 277:       <div><p class="eyebrow">音を聞いて文字を選ぶ</p><p class="readout" id="quiz-mark">？？</p></div>
 278:       <button class="action" id="play-quiz" type="button">問題を出す</button>
 279:     </div>
 280:     <p class="status" id="quiz-status" aria-live="polite">「問題を出す」を押してください。</p>
 281:     <div class="stats"><span>正答率 <strong id="accuracy">—</strong></span><span>連続正解 <strong id="streak">0</strong></span></div>
 282:   </section>
 283: 
 284:   <section class="panel" id="panel-convert" role="tabpanel" aria-labelledby="tab-convert" hidden>
 285:     <label class="eyebrow" for="convert-input">テキスト</label>
 286:     <textarea class="convert-input" id="convert-input" rows="3">こんにちは</textarea>
 287:     <div class="convert-preview" id="convert-preview" aria-label="入力内容"></div>
 288:     <p class="eyebrow">ローマ字</p>
 289:     <p class="convert-roman" id="convert-roman"></p>
 290:     <p class="eyebrow">モールス</p>
 291:     <div class="convert-output" id="convert-output"></div>
 292:     <div class="convert-actions">
 293:       <button class="action" id="play-convert" type="button">再生</button>
 294:       <button class="action" id="stop-convert" type="button" disabled>停止</button>
 295:       <button class="action" id="copy-convert" type="button">コピー</button>
 296:       <label class="notation-toggle"><input id="ascii-notation" type="checkbox">.- 表記</label>
 297:     </div>
 298:     <p class="status" id="convert-status" aria-live="polite"></p>
 299:   </section>
 300: 
 301:   <details>
 302:     <summary>音と練習の設定</summary>
 303:     <div class="settings">
 304:       <label class="setting-line"><span>速度</span><input id="wpm" type="range" min="5" max="30" value="20"><output id="wpm-out">20 WPM</output></label>
 305:       <label class="setting-line"><span>周波数</span><input id="frequency" type="range" min="400" max="900" step="25" value="600"><output id="frequency-out">600 Hz</output></label>
 306:       <label class="switch-line"><span>音を鳴らす</span><input id="sound-on" type="checkbox" checked></label>
 307:       <label class="switch-line"><span>聞くモードで光を表示</span><input id="quiz-light" type="checkbox" checked></label>
 308:       <label class="switch-line"><span>光で送る</span><input id="signal-light" type="checkbox"></label>
 309:       <p class="light-status" id="light-status" aria-live="polite">オフ</p>
 310:     </div>
 311:   </details>
 312: </main>
