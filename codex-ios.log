 736:   function playConversion() {
 737:     clearTimersAndLights();
 738:     if (!conversion?.morseTokens.some(token => token.char !== ' ')) return;
 739:     document.querySelector('#play-convert').disabled = true;
 740:     document.querySelector('#stop-convert').disabled = false;
 741:     document.querySelector('#convert-status').textContent = 'å†ç”Ÿä¸­';
 742:     document.querySelector('#convert-status').className = 'status';
 743:     const epoch = audioEpoch;
 744:     const unit = unitMs();
 745:     let cursor = 0;
 746:     beginSignalPlayback(epoch);
 747:     conversion.morseTokens.forEach((token, tokenIndex) => {
 748:       if (token.char === ' ') { cursor += unit * 7; return; }
 749:       later(() => {
 750:         document.querySelectorAll('.morse-node').forEach(el => el.classList.remove('active'));
 751:         highlightConversion(tokenIndex);
 752:       }, cursor);
 753:       [...token.code].forEach((mark, markIndex) => {
 754:         const duration = mark === '.' ? unit : unit * 3;
 755:         const stepLetter = /^[A-Z]$/.test(token.char) ? reverse[token.code.slice(0, markIndex + 1)] : null;
 756:         if (stepLetter) later(() => node(stepLetter)?.classList.add('active'), cursor);
 757:         tone(cursor, duration, epoch);
 758:         scheduleSignal(cursor, duration, epoch);
 759:         cursor += duration;
 760:         if (stepLetter) later(() => node(stepLetter)?.classList.remove('active'), cursor);
 761:         cursor += unit;
 762:       });
 763:       cursor += unit * 2;
 764:     });
 765:     later(() => {
 766:       clearConvertHighlights();
 767:       document.querySelectorAll('.morse-node').forEach(el => el.classList.remove('active'));
 768:       document.querySelector('#convert-status').textContent = 'å†ç”Ÿã—ã¾ã—ãŸ';
 769:       endSignalPlayback(epoch);
 770:     }, cursor);
 771:   }
