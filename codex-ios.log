 973:     const code = MORSE[letter];
 974:     const unit = unitMs();
 975:     let cursor = 0;
 976:     beginSignalPlayback(epoch);
 977:     [...code].forEach((mark, i) => {
 978:       const duration = mark === '.' ? unit : unit * 3;
 979:       const stepLetter = reverse[code.slice(0, i + 1)];
 980:       if (showLight) later(() => node(stepLetter)?.classList.add('active'), cursor);
 981:       tone(cursor, duration, epoch);
 982:       scheduleSignal(cursor, duration, epoch);
 983:       cursor += duration;
 984:       if (showLight) later(() => node(stepLetter)?.classList.remove('active'), cursor);
 985:       cursor += unit;
 986:     });
 987:     if (showLight) later(() => node(letter)?.classList.add('active'), cursor);
 988:     later(() => endSignalPlayback(epoch), cursor);
 989:     return cursor;
 990:   }
