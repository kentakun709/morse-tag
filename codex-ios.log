 695:     const output = document.querySelector('#convert-output');
 696:     output.replaceChildren(...conversion.morseTokens.flatMap((token, index) => {
 697:       const span = document.createElement('span');
 698:       span.textContent = token.char === ' ' ? '/' : displayCode(token.code);
 699:       span.dataset.tokenIndex = index;
 700:       return [span, document.createTextNode(index === conversion.morseTokens.length - 1 ? '' : ' ')];
 701:     }));
