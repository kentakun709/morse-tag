 474:   function validateModel() {
 475:     const letters = Object.keys(MORSE);
 476:     const unique = new Set(Object.values(MORSE));
 477:     const layout = Object.keys(POS);
 478:     if (letters.length !== 26 || unique.size !== 26 || layout.length !== 26 ||
 479:         letters.some(letter => !POS[letter]) || layout.some(letter => !MORSE[letter])) {
 480:       throw new Error('ç¬¦å·è¡¨ã¨ãƒ—ãƒ¬ãƒ¼ãƒˆé…ç½®ã®æ–‡å­—é›†åˆãŒæ•´åˆã—ã¦ã„ã¾ã›ã‚“ã€‚');
 481:     }
 482:     for (const letter of letters) {
 483:       const code = MORSE[letter];
 484:       for (let i = 0; i < code.length; i++) {
 485:         if (!reverse[code.slice(0, i + 1)]) throw new Error(`${letter}: è¦ªçµŒè·¯ãŒç¬¦å·è¡¨ã«ã‚ã‚Šã¾ã›ã‚“ã€‚`);
 486:       }
 487:     }
 488:     const at = new Map();
 489:     for (const [letter, position] of Object.entries(POS)) {
 490:       const key = position.join(',');
 491:       if (at.has(key)) throw new Error(`${letter}: ${at.get(key)} ã¨åº§æ¨™ãŒé‡è¤‡ã—ã¦ã„ã¾ã™ã€‚`);
 492:       at.set(key, letter);
 493:     }
 494:     for (const [letter, code] of Object.entries(MORSE)) {
 495:       if (code.length === 1) continue;
 496:       const parent = reverse[code.slice(0, -1)];
 497:       const actual = direction(POS[parent], POS[letter]);
 498:       const mark = code.at(-1);
 499:       const expected = code[0] === '.' ? (mark === '.' ? 'right' : 'down') : (mark === '-' ? 'left' : 'down');
 500:       if (actual !== expected && !(letter === 'F' && actual === 'down')) {
 501:         throw new Error(`${letter}: è¦ª ${parent} ã‹ã‚‰ã®æ–¹å‘ãŒ ${actual}ï¼ˆæœŸå¾…å€¤ ${expected}ï¼‰ã§ã™ã€‚`);
 502:       }
 503:     }
 504:     const { labels, hits } = layoutGeometry();
 505:     const overlaps = (a, b) => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
 506:     const labelBoxes = {};
 507:     for (const [letter, label] of Object.entries(labels)) {
 508:       const rendered = node(letter).querySelector('.node-label').getBBox();
 509:       const box = labelBoxes[letter] = {
 510:         left: rendered.x, right: rendered.x + rendered.width,
 511:         top: rendered.y, bottom: rendered.y + rendered.height
 512:       };
 513:       for (const [other, hit] of Object.entries(hits)) {
 514:         if (other !== letter && overlaps(box, hit)) throw new Error(`${letter}: ãƒ©ãƒ™ãƒ«ãŒ ${other} ã®å½“ãŸã‚Šåˆ¤å®šã¨é‡ãªã£ã¦ã„ã¾ã™ã€‚`);
 515:       }
 516:     }
 517:     for (const [letter, box] of Object.entries(labelBoxes)) {
 518:       for (const [other, otherBox] of Object.entries(labelBoxes)) {
 519:         if (letter < other && overlaps(box, otherBox)) throw new Error(`${letter}: ${other} ã¨ãƒ©ãƒ™ãƒ«ãŒé‡ãªã£ã¦ã„ã¾ã™ã€‚`);
 520:       }
 521:     }
 522:     for (const [letter, hit] of Object.entries(hits)) {
 523:       if (hit.left < 15 || hit.right > 505) throw new Error(`${letter}: å½“ãŸã‚Šåˆ¤å®šãŒæ¿ã®å¤–ã§ã™ã€‚`);
 524:       for (const [other, otherHit] of Object.entries(hits)) {
 525:         if (letter < other && overlaps(hit, otherHit)) throw new Error(`${letter}: ${other} ã¨å½“ãŸã‚Šåˆ¤å®šãŒé‡ãªã£ã¦ã„ã¾ã™ã€‚`);
 526:       }
 527:     }
 528:     return true;
 529:   }
