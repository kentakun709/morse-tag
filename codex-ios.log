 670:     console.assert(convertTokenizedText('ä»Šæ—¥ã¯è‰¯ã„å¤©æ°—', activeTokenizer.tokenize('ä»Šæ—¥ã¯è‰¯ã„å¤©æ°—')).roman.toUpperCase() === 'KYOU WA II TENKI', 'ä»Šæ—¥ã¯è‰¯ã„å¤©æ°— â†’ KYOU WA II TENKI');
